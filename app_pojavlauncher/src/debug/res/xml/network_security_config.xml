<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the local test stack serves the pack over plain http on the loopback, through adb reverse.
     Android 12 blocks that for targetSdk 34; newer Android versions let the loopback through on their own. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
